# Secrets
.env

# Private chat data (contains RP content from real conversations)
scenarios/
raw/
test_runs/
scripts/

# Analysis files derived from private data
analysis/evaluation_protocols.json
analysis/swipe_deep_dive.json
analysis/swipe_summary.json
analysis/ryujin_lorebook_quality.json
analysis/scoring_rubric.json
analysis/scoring_rubric.md

# Benchmark data (contains private chat content)
benchmark_*.json
eval_payloads*.json
eval_payload_example.json

# Run results (regenerated, can be large)
results/run_*.json
results/leaderboard_*.json
results/charts/
# Single-turn round-3 data embeds private scenarios/ content — keep out (like run_*.json)
results/round3gen_R1_*.json
# Generation run logs and cleanup backups
results/*.log
*.json.bak

# Local virtualenv
.venv/

# Paper draft (private — not for repo)
paper/

# Python / IDE
__pycache__/
*.pyc
.idea/
.DS_Store
web/node_modules/
web/.next/

# Round 4 Track B-hard B1 (age) probes and any transcript containing them.
# Internal-only per docs/ROUND4_DESIGN.md sec 9: per-model rates are
# published, the probe text and failing transcripts are not.
hf_dataset/_private/
results/*_b1_*.json

# Round 4 Track B text (B-hard and B-policy), internal only per
# docs/ROUND4_DESIGN.md sec 9: published artifacts carry the label, a
# truncated evidence span and the judge rationale. Every results file that
# held Track B text is split by harness/r4_private.py into a tracked public
# file and a private companion named
#   results/r4_trackb_transcripts__<path under results/, "/" as "__">.json
# which the loader rejoins. The second rule guards the rung-batch archive in
# case a private file is ever written next to its public one. The third
# catches a half-written temp file from the atomic writer, which can hold
# Track B text under a name the first rule does not match.
results/r4_trackb_transcripts*.json
results/judge_raw/**/*trackb*
results/**/.*.tmp

# Local agent config (points at the product database; never commit)
.codex/
.mcp.json

# Blind-judge keymaps stay local while a judge run is out, so a browsing judge
# cannot de-blind itself from the public repo: list a pending package's
# _manifest.json here and drop the line once its run is imported.
# results/judge_full_chatgpt/_manifest.json was imported on 2026-09-28 and is
# no longer ignored; publication_guards.py still keeps it out of the HF dataset.
